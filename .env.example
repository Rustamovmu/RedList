# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://wildatlas:M@localhost:5433/wildatlas
PORT=4000
# Public origin of the frontend (used for CORS-free same-origin checks and revalidation)
WEB_ORIGIN=http://localhost:3000
# Frontend revalidation webhook (frontend app/api/revalidate) + shared secret
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-long-random-string
# Set true only behind HTTPS (production)
COOKIE_SECURE=false
# One-time admin bootstrap (npm run admin:create)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
