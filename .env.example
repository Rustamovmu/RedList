# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://wild:wild@localhost:5433/wild
# Postgres.app instead of Docker: use port 5432, then run npm run db:setup:local
PORT=4000
# Public origin of the frontend (used for CORS-free same-origin checks and revalidation)
WEB_ORIGIN=http://localhost:3000
# Frontend revalidation webhook (frontend app/api/revalidate) + shared secret
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-long-random-string
# Media storage (local disk; re-encoded WebP variants only, never the original upload) and upload size limit
MEDIA_DIR=./storage/media
MEDIA_MAX_BYTES=15000000
# Optional: contact for the User-Agent of outbound fetches (import image downloads, links:check).
# Wikimedia and others ask bots to identify an operator contact. Use a project URL or role address, not a personal one.
# FETCH_CONTACT=https://example.org/contact
# Set true only behind HTTPS (production)
COOKIE_SECURE=false
# One-time admin bootstrap (npm run admin:create). Password: at least 12 characters, no placeholders.
# Remove ADMIN_PASSWORD once the account exists.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
