{
  "name": "wildward-api",
  "version": "0.1.0",
  "private": true,
  "description": "Wildward R1 backend: NestJS + Drizzle ORM + PostgreSQL/PostGIS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "db:up": "docker compose up -d db",
    "db:setup:local": "bash scripts/setup-local-db.sh",
    "db:check": "node scripts/check-db.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only src/cli/migrate.ts",
    "db:seed:regions": "ts-node --transpile-only src/cli/seed-regions.ts",
    "db:seed:vocab": "ts-node --transpile-only src/cli/seed-vocab.ts",
    "db:seed:fixtures": "ts-node --transpile-only src/cli/seed-fixtures.ts",
    "admin:create": "ts-node --transpile-only src/cli/admin-create.ts",
    "staff:link": "ts-node --transpile-only src/cli/staff-link.ts",
    "e2e:prepare": "ts-node --transpile-only src/cli/e2e-prepare.ts",
    "e2e:api": "npm run e2e:prepare && ts-node --transpile-only src/main.ts",
    "import": "ts-node --transpile-only src/cli/import.ts",
    "links:check": "ts-node --transpile-only src/cli/links-check.ts",
    "validate:catalogue": "ts-node --transpile-only src/cli/validate-catalogue.ts",
    "status:sheet": "ts-node --transpile-only src/cli/status-check.ts sheet",
    "status:import": "ts-node --transpile-only src/cli/status-check.ts import",
    "openapi:export": "ts-node --transpile-only src/cli/export-openapi.ts",
    "test": "jest --config jest.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0"
  }
}
