# Production stack settings. Copy to deploy/.env.prod (git-ignored) and fill in. docs/DEPLOYMENT.md explains each.
# Never commit deploy/.env.prod.

# A separate compose project per deployment, so a shared VPS never mixes containers, networks or volumes.
COMPOSE_PROJECT_NAME=wildward

# Public origin, exactly as visitors type it (scheme + host, no trailing slash). Used for canonical URLs, the
# sitemap and Open Graph (built into the web image), and for the API's Origin check on staff requests.
SITE_URL=https://example.org
# Optional contact link on /about and /privacy (a project URL or role address, not a personal one).
CONTACT_URL=

# Database. Use letters and digits only for the password (it goes into a URL). openssl rand -hex 24
POSTGRES_USER=wildward
POSTGRES_PASSWORD=
POSTGRES_DB=wildward

# Shared secret between the API and the web app's revalidate hook. openssl rand -hex 32
REVALIDATE_SECRET=

# Staff cookies: true behind HTTPS. Only a local rehearsal on http://127.0.0.1 may set false.
COOKIE_SECURE=true

# Where Nginx listens on the host. Keep 127.0.0.1 when another proxy on the host terminates TLS;
# use 0.0.0.0 only if this container faces the internet itself.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Nginx site: ./nginx/http.conf (TLS ends in front of it) or ./nginx/https.conf (TLS in the container).
NGINX_SITE_CONF=./nginx/http.conf

# Optional: operator contact for the User-Agent of outbound fetches (links:check, import downloads).
FETCH_CONTACT=
MEDIA_MAX_BYTES=15000000

# Backups (scripts/backup.sh). Keep a copy OFF this host as well: docs/DEPLOYMENT.md "Backups".
BACKUP_DIR=../backups
BACKUP_KEEP=14
